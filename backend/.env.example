# LLM provider API key
LLM_API_KEY=

# Secret used for device authentication
ADMIN_SECRET=

# Application configuration
APP_ENV=development

# Backend-to-agent v2 configuration and connected Studio/PWA panels
# Generate distinct random credentials of at least 32 characters for each role.
# See app/docs/backend-agent.md for the registration JSON format.
AGENT_DEVICES_JSON=[]
# Optional UTF-8 registration file; overrides AGENT_DEVICES_JSON when set.
AGENT_DEVICES_FILE=
AGENT_MAX_ACTIVE_JOBS=16
AGENT_MAX_JOBS_PER_DEVICE=4
AGENT_JOB_TIMEOUT=150

# Optional stable HTTPS origins for phone pairing. Without PUBLIC_BACKEND_URL,
# local Studio pairing uses the automatic Cloudflare tunnel when available.
PUBLIC_BACKEND_URL=
# Set the deployed phone app origin to make QR codes open the PWA directly.
PWA_PUBLIC_URL=
# Full-app start.py sets off and owns both backend/PWA quick tunnels.
# Set auto to enable standalone tunneling after HTTP startup; off disables it.
# Empty preserves opt-in JANUS_AUTO_TUNNEL=1 from the legacy npm launcher.
JANUS_TUNNEL_MODE=
JANUS_BACKEND_PORT=8000
# Launcher-owned atomic JSON {"backend": HTTPS-or-null, "pwa": HTTPS-or-null}.
# Pairing reads this dynamically. Missing/empty backend means not ready.
JANUS_PUBLIC_URLS_FILE=

# Optional SQLite path; default is app/app.db, preserved by the Compose mount.
# Use an existing writable directory and a persistent volume in production.
# JANUS_DB_PATH=/app/data/janus.sqlite

# Supported Google Gemini SDK; live generation needs one of these credentials.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_CONCURRENT=8
GEMINI_TIMEOUT=20
GEMINI_API_ATTEMPTS=2

# Portable generated C uses JANUS's included Docker worker. Install Docker Desktop; startup prepares its image after local approval.
# Leave unset to select the shipped worker automatically. An explicit custom local adapter overrides it.
# AGENT_ISOLATION_ADAPTER=your_installed_module:create_boundary

# Optional: Tiger Data (TimescaleDB on Tiger Cloud) as a time-series store for metric history, "why was my laptop
# slow?" answers and the activity log. SQLite stays the app database. Leave empty to turn all of it off;
# `npm run setup` creates the schema when this is set. Example: postgres://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require
TIGER_DATABASE_URL=

# Text your laptop (iMessage via Photon Spectrum). npm start includes it when all settings below are valid.
# Use npm start -- --no-imessage to disable it for one run; credentials are never generated for Photon.
# Credentials from your Photon Spectrum project:
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Comma-separated E.164 numbers that may command the laptop, e.g. +15551234567. Everyone else is ignored.
IMESSAGE_ALLOWED_SENDERS=
# Service token for the sidecar -> backend call (generated by `npm run setup`; loopback-only endpoint).
MESSAGING_SERVICE_TOKEN=
# Optional: `0` disables the once-a-day startup greeting text.
# IMESSAGE_GREETING=1
# Optional: which registered laptop to control (launcher default: the selected laptop), and `0` to disable the Gemini intent fallback.
# IMESSAGE_DEVICE_ID=
# IMESSAGE_AI_FALLBACK=1
