# LLM provider API key
LLM_API_KEY=

# Secret used for device authentication
ADMIN_SECRET=

# Application configuration
APP_ENV=development

# Backend-to-agent v2 configuration and connected Studio/PWA panels
# Generate distinct random credentials of at least 32 characters for each role.
# See app/docs/backend-agent.md for the registration JSON format.
AGENT_DEVICES_JSON=[]
# Optional UTF-8 registration file; overrides AGENT_DEVICES_JSON when set.
AGENT_DEVICES_FILE=
AGENT_MAX_ACTIVE_JOBS=16
AGENT_MAX_JOBS_PER_DEVICE=4
AGENT_JOB_TIMEOUT=150

# Optional stable HTTPS origins for phone pairing. Without PUBLIC_BACKEND_URL,
# local Studio pairing uses the automatic Cloudflare tunnel when available.
PUBLIC_BACKEND_URL=
# Set the deployed phone app origin to make QR codes open the PWA directly.
PWA_PUBLIC_URL=

# Optional SQLite path; default is app/app.db, preserved by the Compose mount.
# Use an existing writable directory and a persistent volume in production.
# JANUS_DB_PATH=/app/data/janus.sqlite

# Supported Google Gemini SDK; live generation needs one of these credentials.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_CONCURRENT=8
GEMINI_TIMEOUT=20
GEMINI_API_ATTEMPTS=2
