{
  "private": true,
  "type": "module",
  "workspaces": [
    "shared/*",
    "PWA",
    "frontend",
    "imessage"
  ],
  "scripts": {
    "test:startup": "uv run --locked --project backend python -m unittest discover -s tests/startup -v",
    "test": "node scripts/test.mjs all",
    "test:unit": "node scripts/test.mjs unit",
    "test:coverage": "node scripts/test.mjs coverage",
    "test:e2e": "node scripts/test.mjs browser",
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/start.mjs",
    "doctor": "node scripts/doctor.mjs",
    "start:imessage": "node scripts/start.mjs --imessage",
    "start:demo": "node scripts/start.mjs --imessage --screen --tunnel"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "vitest": "^5.0.3"
  }
}
